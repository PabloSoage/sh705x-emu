    <string name="pause">Pause</string>
    <string name="next_tooth">Next tooth</string>
    <string name="next_edge">Next edge</string>
    <string name="idle_on_torque">Idle on its torque</string>
    <string name="power_off">Power off</string>
    <string name="speed">Speed</string>
    <string name="real_time">Real time</string>
    <string name="plants">Plants</string>
    <string name="plants_off">Off</string>
    <string name="plants_held">Held</string>
    <string name="plants_turning">On its torque</string>
    <string name="engine_speed">Engine speed: %1$.0f rpm</string>
