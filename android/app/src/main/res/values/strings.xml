<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">SH705x emulator</string>

    <string name="load_intro">Runs an SH705x ECU\'s own firmware on the phone, on a simulated engine. Pick the ECU\'s flash dump (1.5 MB) and, if you have it, its EEPROM dump (8 KB).</string>
    <string name="pick_flash">Flash dump…</string>
    <string name="pick_eeprom">EEPROM dump (optional)…</string>
    <string name="picked">%1$s (%2$d bytes)</string>
    <string name="power_on">Power on</string>
    <string name="no_firmware">No firmware comes with the app: the dumps are read from your storage into memory and never copied or sent anywhere.</string>

    <string name="status">%1$.3f s of ECU time · %2$.0f rpm · ×%3$.2f real time</string>
    <string name="stopped_by">Stopped: %1$s</string>
