    <string name="wheel_gap">gap</string>
    <string name="phase_assumed">Crank 60-4 and cam under their sensors (red). The cylinders\' phase to the crank is assumed (cylinder 1 at 0°, firing 1-3-4-2): where its top dead centre falls relative to the gap is not known.</string>

    <string name="window">Window</string>
    <string name="signals">Crank and cam signals; one-shot pulses of channel 8</string>
    <string name="crank">crank</string>
    <string name="cam">cam</string>
    <string name="injector">inj %1$d</string>
    <string name="no_injection">The injectors (TO8I–L) never pulse here: the ECU does not inject while the immobilizer, whose other side is not emulated, keeps it shut. The rail pressure shown is the sensor as set, not a combustion.</string>

    <string-array name="strokes">
        <item>power</item>
        <item>exhaust</item>
        <item>intake</item>
        <item>compr.</item>
    </string-array>

